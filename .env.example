# Copy this file to .env and fill in the values. .env is not committed.

# local, test or production
APP_ENVIRONMENT=local

# DEBUG, INFO, WARNING or ERROR
APP_LOG_LEVEL=INFO

APP_DATABASE_URL=sqlite:///./data/app.db

# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET_KEY=

APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
