# Copy this file to .env and fill in the values. .env is not committed.

# local, test or production
APP_ENVIRONMENT=local

# DEBUG, INFO, WARNING or ERROR
APP_LOG_LEVEL=INFO

APP_DATABASE_URL=sqlite:///./data/app.db

# Required, at least 32 characters, and in production at least 16 different
# ones. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and makes the audit seals stop matching:
# see docs/secrets.md.
APP_JWT_SECRET_KEY=

APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Failed logins allowed for one email within the window, in seconds, before
# further attempts are refused (429) without checking the password.
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_FAILURE_WINDOW_SECONDS=900

# How often one person may ask and search, before calls are refused (429).
# Every call counts, however it ends. The daily limit caps what one person can
# spend on the model.
APP_ASK_LIMIT_PER_MINUTE=10
APP_ASK_LIMIT_PER_DAY=200
APP_SEARCH_LIMIT_PER_MINUTE=30

# Largest file accepted at ingestion, in bytes (default 10 MB). A request body
# larger than this plus 64 KB is refused before it is read.
APP_MAX_UPLOAD_BYTES=10485760

# How documents are split into chunks, in characters. Changing these means
# re-chunking and re-embedding every document.
APP_CHUNK_MAX_CHARACTERS=800
APP_CHUNK_OVERLAP_CHARACTERS=120

# The embedding model. It is downloaded once and then runs locally. Changing it
# means embedding every chunk again.
APP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
APP_EMBEDDING_BATCH_SIZE=32
# true = load the model from the local cache only, with no network call
APP_EMBEDDING_OFFLINE=false

# Where the vector index is saved. It holds vectors of every document, so
# protect it like the database.
APP_INDEX_DIRECTORY=data/index
# Index versions to keep for rollback, the current one included
APP_INDEX_KEEP_VERSIONS=3

# Longest question accepted, in characters
APP_MAX_QUESTION_CHARACTERS=1000

# Chunks retrieved per question
APP_RETRIEVAL_TOP_K=5
# Below this best score, the answer is "no information available". Measured
# for the default embedding model; measure again if you change the model.
APP_RETRIEVAL_MIN_SCORE=0.35

# Reranking is off unless a cross-encoder is named. It runs locally like the
# embedding model and adds roughly half a second per question on a CPU.
# APP_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Chunks the reranker chooses from
APP_RERANK_CANDIDATES=20

# Most document text sent to the LLM for one question, in characters. At
# least APP_CHUNK_MAX_CHARACTERS, so the best chunk always fits.
APP_CONTEXT_MAX_CHARACTERS=6000

# Which language model answers questions:
#   none    no answers, only search results. Nothing is sent anywhere.
#   ollama  runs on this machine (install Ollama and `ollama pull llama3.1`).
#           Nothing leaves the machine, but on a laptop CPU an answer takes
#           about a minute, so set APP_LLM_TIMEOUT_SECONDS=300 with it.
#   groq    hosted and fast, free tier. The prompt, company text, goes to Groq.
#           Needs APP_LLM_API_KEY. Its model reasons before answering, and the
#           reasoning counts against APP_LLM_MAX_OUTPUT_TOKENS, so set that to
#           1000 with it.
APP_LLM_PROVIDER=none
# Optional, each overrides the provider's preset. With an API key, the base
# URL must be https unless it is this machine.
# APP_LLM_MODEL=
# APP_LLM_BASE_URL=
# APP_LLM_CONTEXT_TOKENS=
# APP_LLM_API_KEY=

# Every call to the language model. A question waits at most about
# (retries + 1) x timeout. Only failures the provider may recover from are
# retried.
APP_LLM_MAX_OUTPUT_TOKENS=600
APP_LLM_TIMEOUT_SECONDS=30
APP_LLM_MAX_RETRIES=2

# Only for docker compose: where the API and the UI are published, on this
# machine. Compose passes on only the settings compose.yaml names; see
# docs/docker.md.
# API_PORT=8000
# UI_PORT=8501
